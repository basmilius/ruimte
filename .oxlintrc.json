{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  // The hero reel is a throwaway prototype page, built into one artifact; a take that ships is ported to TypeScript.
    "ignorePatterns": ["apps/ios/App/Resources/document-renderer.js", "docs/research/hero-reel/**"],
  "rules": {
    "curly": "error",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    // Only says the React Compiler skipped a component, and the client does not build with it.
    "react/preserve-manual-memoization": "off"
  },
  "overrides": [
    {
      // Next.js reads these exports from a layout or page, beside the component.
      "files": ["apps/site/src/app/**"],
      "rules": {
        "react/only-export-components": ["warn", { "allowConstantExport": true, "allowExportNames": ["metadata", "viewport", "dynamic"] }]
      }
    }
  ]
}
