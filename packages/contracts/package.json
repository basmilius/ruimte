{
    "name": "@ruimte/contracts",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "exports": {
        ".": "./src/index.ts"
    },
    "scripts": {
        "typecheck": "tsc --noEmit && bun run check:swift",
        "generate:swift": "bun scripts/generate-swift.ts && bun ../../apps/ios/Scripts/generate-renderer.ts && bun ../../apps/ios/Scripts/generate-visual.ts && bun ../../apps/server/scripts/generate-native-ui.ts",
        "check:swift": "bun scripts/generate-swift.ts --check && bun ../../apps/ios/Scripts/generate-renderer.ts --check && bun ../../apps/ios/Scripts/generate-visual.ts --check && bun ../../apps/server/scripts/generate-native-ui.ts --check"
    },
    "dependencies": {
        "@adecore/agent-contracts": "0.21.2",
        "@adecore/diagram": "0.21.2",
        "@adecore/drawing": "0.21.2",
        "@adecore/plan": "0.21.2",
        "@ruimte/pulsar": "workspace:*",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@types/bun": "^1.4.2",
        "typescript": "^7.0.2"
    }
}
