{
  "name": "@ruimte/contracts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && bun run check:swift",
    "generate:swift": "bun scripts/generate-swift.ts && bun ../../apps/ios/Scripts/generate-renderer.ts",
