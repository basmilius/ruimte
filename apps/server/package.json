{
  "name": "@ruimte/server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "bun src/smoke.ts",
    "compile": "bun scripts/compile.ts",
    "snapshot-prices": "bun scripts/snapshot-prices.ts",
    "docker:up": "docker compose -f docker/compose.yml up -d --build --wait",
    "docker:down": "docker compose -f docker/compose.yml down",
    "docker:pair": "docker/pair.sh",
    "docker:test": "RUIMTE_DOCKER=1 bun test src/docker"
  },
  "dependencies": {
    "@ruimte/contracts": "workspace:*",
    "@ruimte/drawing": "workspace:*",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "typescript": "~6.0.2"
  }
}
