{
    "name": "@ruimte/server",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "RUIMTE_HOME=${RUIMTE_DEV_HOME:-$HOME/.ruimte-dev} bun --conditions=source --watch src/main.ts --port 4211",
        "start": "bun src/main.ts",
        "typecheck": "tsc --noEmit",
        "smoke": "bun src/smoke.ts",
        "compile": "bun scripts/compile.ts",
        "measure:memory": "bun scripts/measure-team-memory.ts",
        "docker:up": "docker compose -f docker/compose.yml up -d --build --wait",
        "docker:down": "docker compose -f docker/compose.yml down",
        "docker:reset": "docker compose -f docker/compose.yml --profile test down -v",
        "docker:login": "docker exec -it ruimte-remote bun /app/apps/server/src/main.ts login --port 4310",
        "docker:test": "docker/test.sh"
    },
    "dependencies": {
        "@adecore/agents": "0.20.1",
        "@adecore/database": "0.20.1",
        "@adecore/diagram": "0.20.1",
        "@adecore/drawing": "0.20.1",
        "@adecore/intelligent-ui": "0.0.0",
        "@adecore/lsp": "0.20.1",
        "@adecore/merge": "0.20.1",
        "@adecore/plan": "0.20.1",
        "@adecore/service": "0.20.1",
        "@modelcontextprotocol/client": "^2.1.0",
        "@ruimte/actions": "workspace:*",
        "@ruimte/contracts": "workspace:*",
        "@ruimte/pulsar": "workspace:*",
        "@ruimte/service": "workspace:*",
        "@xterm/addon-serialize": "^0.14.0",
        "@xterm/headless": "^6.0.0",
        "linkedom": "^0.18.13",
        "reflect-metadata": "0.2.2",
        "serve-sim": "0.1.46",
        "werift": "0.24.4",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@types/bun": "^1.4.2",
        "typescript": "^7.0.2"
    }
}
