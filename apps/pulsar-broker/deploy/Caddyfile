# TLS for the broker. Caddy gets and renews the certificate on its own once the name points at this
# host and ports 80 and 443 are open. It proxies WebSocket upgrades as they are, and appends the
# client's address to X-Forwarded-For, which the broker reads with --trust-proxy.
{
	servers {
		# Cloudflare's published ranges (https://www.cloudflare.com/ips-v4 and ips-v6), for a name behind
		# its proxy. The broker trusts CF-Connecting-IP from the same ranges on its own (--trust-cloudflare),
		# so this only fixes Caddy's own logs. Caddy 2.6.2 rejects the option; leave the block out there.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	}
}

broker.ruimte.app {
	reverse_proxy 127.0.0.1:4400
}
