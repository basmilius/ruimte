{
    "name": "@ruimte/pulsar-worker",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "WRANGLER_BUILD_CONDITIONS=source,workerd,worker,browser wrangler dev --local",
        "deploy": "bun ../../scripts/deploy-pulsar-worker.ts",
        "migrate:local": "wrangler d1 migrations apply ruimte-pulsar --local",
        "typecheck": "bun check --no-script && bun check --no-script -p tsconfig.test.json"
    },
    "dependencies": {
        "@adecore/agents": "0.49.1",
        "@ruimte/pulsar": "workspace:*",
        "@ruimte/telemetry": "workspace:*",
        "@sentry/cloudflare": "11.8.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^5.20261030.1",
        "@types/bun": "^1.4.4",
        "miniflare": "4.20260730.0",
        "typescript": "^7.0.2",
        "wrangler": "^4.156.0"
    }
}
