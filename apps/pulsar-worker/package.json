{
  "name": "@ruimte/pulsar-worker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "wrangler d1 migrations apply ruimte-pulsar --remote && wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply ruimte-pulsar --local",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@ruimte/pulsar": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260922.1",
    "@types/bun": "^1.4.2",
    "miniflare": "4.20260730.0",
    "typescript": "~6.0.3",
    "wrangler": "^4.136.3"
  }
}
