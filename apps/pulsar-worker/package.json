{
    "name": "@ruimte/pulsar-worker",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "WRANGLER_BUILD_CONDITIONS=source,workerd,worker,browser wrangler dev --local",
        "deploy": "bun ../../scripts/deploy-pulsar-worker.ts",
        "migrate:local": "wrangler d1 migrations apply ruimte-pulsar --local",
        "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
    },
    "dependencies": {
        "@adecore/agents": "0.21.2",
        "@ruimte/pulsar": "workspace:*",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^5.20260922.1",
        "@types/bun": "^1.4.2",
        "miniflare": "4.20260730.0",
        "typescript": "^7.0.2",
        "wrangler": "^4.136.3"
    }
}
