{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ruimte-pulsar",
  "main": "src/index.ts",
  "account_id": "5e565cf9fa55b0eae1f8131903da2ca9",
  // The newest date the pinned miniflare's workerd knows, so the tests run the same runtime rules.
  "compatibility_date": "2026-08-01",
  // `@sentry/cloudflare` needs Node's AsyncLocalStorage and diagnostics channels (`src/telemetry.ts`).
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [{ "pattern": "pulsar.ruimte.app", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ruimte-pulsar",
      "database_id": "dcbaa2c2-a829-4564-b593-eeede567ce04",
      "migrations_dir": "migrations"
    }
  ],
  // One per distinct number in `LIMITS` (`src/rate-window.ts`); the key holds the route, so they share one.
  "ratelimits": [
    { "name": "RATE_LIMIT_5", "namespace_id": "2002", "simple": { "limit": 5, "period": 60 } },
    { "name": "RATE_LIMIT_10", "namespace_id": "2003", "simple": { "limit": 10, "period": 60 } },
    { "name": "RATE_LIMIT_20", "namespace_id": "2004", "simple": { "limit": 20, "period": 60 } },
    { "name": "RATE_LIMIT_30", "namespace_id": "2005", "simple": { "limit": 30, "period": 60 } },
    { "name": "RATE_LIMIT_60", "namespace_id": "2006", "simple": { "limit": 60, "period": 60 } },
    { "name": "RATE_LIMIT_120", "namespace_id": "2007", "simple": { "limit": 120, "period": 60 } },
    { "name": "RATE_LIMIT_240", "namespace_id": "2008", "simple": { "limit": 240, "period": 60 } }
  ],
  "vars": {
    "PUBLIC_ORIGIN": "https://pulsar.ruimte.app",
    "APNS_TOPIC": "app.ruimte.mobile",
    "APNS_TEAM_ID": "7RGV9KKX87",
    "ALLOWED_ORIGINS": "https://station.ruimte.app,https://bench.ruimte.app",
    // The nightly cleanup checks in here (`src/check-in.ts`), so a run that is missed or fails opens an issue.
    "OBSERVATORY_CHECK_IN_URL": "https://ingest.bmnw.nl/api/7/envelope/?sentry_key=9ff9af7a3b804d228a025d52b6040176",
    // Errors and log lines (`src/telemetry.ts`); the deploy adds OBSERVATORY_RELEASE, `pulsar@<commit>`.
    "OBSERVATORY_DSN": "https://9ff9af7a3b804d228a025d52b6040176@ingest.bmnw.nl/7"
  },
  // Expired logins, codes, rate limit windows and dead sessions; and the model benchmarks, every three hours.
  // `scheduled()` tells them apart by the expression, so a change here is a change in `src/index.ts` too.
  "triggers": { "crons": ["17 4 * * *", "17 */3 * * *"] },
  "observability": { "enabled": true }
}
