{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ruimte-pulsar",
  "main": "src/index.ts",
  "account_id": "5e565cf9fa55b0eae1f8131903da2ca9",
  // The newest date the pinned miniflare's workerd knows, so the tests run the same runtime rules.
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [{ "pattern": "pulsar.ruimte.app", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ruimte-pulsar",
      "database_id": "dcbaa2c2-a829-4564-b593-eeede567ce04",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "PUBLIC_ORIGIN": "https://pulsar.ruimte.app",
    "APNS_TOPIC": "app.ruimte.mobile",
    "APNS_TEAM_ID": "7RGV9KKX87",
    "ALLOWED_ORIGINS": "https://station.ruimte.app"
  },
  // Expired logins, codes, rate limit windows and dead sessions; and the model benchmarks, every three hours.
  // `scheduled()` tells them apart by the expression, so a change here is a change in `src/index.ts` too.
  "triggers": { "crons": ["17 4 * * *", "17 */3 * * *"] },
  "observability": { "enabled": true }
}
