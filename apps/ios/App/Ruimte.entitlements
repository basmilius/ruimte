<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>aps-environment</key><string>$(PUSH_ENVIRONMENT)</string>
    <key>com.apple.security.application-groups</key><array><string>group.app.ruimte.mobile</string></array>
    <key>keychain-access-groups</key><array><string>$(AppIdentifierPrefix)app.ruimte.mobile</string><string>$(AppIdentifierPrefix)app.ruimte.mobile.push</string></array>
    <key>com.apple.developer.usernotifications.time-sensitive</key><true/>
</dict></plist>
