    "It has %lld commits of its own and %lld from %@. A pull only fast-forwards until you choose." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It has %#@own@ of its own and %2$lld from %3$@. A pull only fast-forwards until you choose."
          },
          "substitutions" : {
            "own" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg commit"
                    }
