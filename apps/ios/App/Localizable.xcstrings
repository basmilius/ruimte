    },
    "Every client that reaches this machine sees these. Leave it empty for the machine's own name." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke client die deze machine bereikt, ziet ze. Laat het leeg voor de eigen naam van de machine."
          }
        }
      }
    },
    "It loses access the next time it connects, and signing in through an account will not let it back in." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
