    },
    "%@ is deleted from the chat on every device. This cannot be undone." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wordt op elk apparaat uit de chat verwijderd. Dit kan niet ongedaan worden gemaakt."
