        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hij heeft %#@own@ van zichzelf en %2$lld van %3$@. Een pull doet alleen een fast-forward tot je kiest."
          },
          "substitutions" : {
            "own" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg commit"
                    }
