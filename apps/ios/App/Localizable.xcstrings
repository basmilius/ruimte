          "stringUnit" : {
            "state" : "translated",
            "value" : "De chat werkt in de map van het project en staat tussen de weergaven ervan."
          }
        }
      }
    },
    "The checkout goes back to how it was before the %@. What was resolved so far is lost." : {
      "comment" : "%@ is a git operation: merge, rebase, cherry-pick or revert",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De checkout gaat terug naar hoe hij was vóór de %@. Wat tot nu toe is opgelost, gaat verloren."
          }
        }
      }
    },
    "The cherry-pick is finished." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De cherry-pick is klaar."
          }
        }
