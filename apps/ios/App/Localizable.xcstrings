      }
    },
    "-%lld" : {
      "shouldTranslate" : false
    },
    "A flag this machine started with decides this." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een vlag waarmee deze machine startte, bepaalt dit."
          }
        }
      }
    },
    "A machine on your account shows up here by itself. You put it there from the machine itself." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een machine op je account verschijnt hier vanzelf. Je zet hem daar vanaf de machine zelf."
          }
        }
      }
    },
    "Add a machine to see its projects, devices and processes." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg een machine toe om de projecten, apparaten en processen erop te zien."
          }
        }
      }
    },
    "An app gets in by signing in to the account %@ is on." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een app komt binnen door in te loggen op het account waar %@ op staat."
