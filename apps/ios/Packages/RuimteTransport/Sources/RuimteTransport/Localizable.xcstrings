{
  "sourceLanguage" : "en",
  "strings" : {
    "A broker signal names the machine but is not signed by it." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een broker-signaal noemt de machine, maar is niet door hem ondertekend."
          }
        }
      }
    },
    "A signal on the local network names the machine but is not signed by it." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een signaal op het lokale netwerk noemt de machine, maar is niet door hem ondertekend."
          }
        }
      }
    },
    "No network path to the machine: ICE failed." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen netwerkpad naar de machine: ICE is mislukt."
          }
        }
      }
    },
    "The broker challenge names a different host." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De broker-challenge noemt een andere host."
          }
        }
      }
    },
    "The broker is limiting this client. Try again later." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De broker beperkt deze client. Probeer het later opnieuw."
          }
        }
      }
    },
    "The broker needs a secure WebSocket URL." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De broker heeft een beveiligde WebSocket-URL nodig."
          }
        }
      }
    },
    "The broker refused this connection attempt." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De broker weigerde deze verbindingspoging."
          }
        }
      }
    },
    "The broker returned expired ICE credentials." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De broker gaf verlopen ICE-gegevens terug."
          }
        }
      }
    },
    "The channel opened before its answer was applied." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het kanaal ging open voordat het antwoord ervan was toegepast."
          }
        }
      }
    },
    "The connection sent invalid UTF-8." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De verbinding stuurde ongeldige UTF-8."
          }
        }
      }
    },
    "The data channel is not open." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het datakanaal is niet open."
          }
        }
      }
    },
    "The data channel refused a frame." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het datakanaal weigerde een frame."
          }
        }
