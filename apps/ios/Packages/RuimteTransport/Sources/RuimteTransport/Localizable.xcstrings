    },
    "The direct connection did not come up within 20 seconds." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De directe verbinding kwam niet binnen 20 seconden tot stand."
          }
        }
      }
    },
    "The file changed while it played." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het bestand veranderde tijdens het afspelen."
          }
        }
      }
    },
    "The machine connection is not authenticated." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De verbinding met de machine is niet geauthenticeerd."
