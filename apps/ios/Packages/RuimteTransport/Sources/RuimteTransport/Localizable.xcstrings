{
  "sourceLanguage" : "en",
  "strings" : {
    "A connection request claims to come from the machine but cannot be verified." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een verbindingsverzoek zegt van de machine te komen, maar is niet te controleren."
          }
        }
      }
    },
    "A connection on the local network claims to come from the machine but cannot be verified." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een verbinding op het lokale netwerk zegt van de machine te komen, maar is niet te controleren."
          }
        }
      }
    },
    "No network path to the machine." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen netwerkpad naar de machine."
          }
        }
      }
    },
    "The broker challenge names a different host." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De broker-challenge noemt een andere host."
          }
        }
      }
    },
    "The broker is limiting this device. Try again later." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De broker beperkt dit apparaat. Probeer het later opnieuw."
          }
        }
      }
    },
    "The broker needs a secure WebSocket URL." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De broker heeft een beveiligde WebSocket-URL nodig."
          }
        }
      }
    },
    "The broker refused this connection attempt." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De broker weigerde deze verbindingspoging."
          }
        }
      }
    },
    "The broker returned expired ICE credentials." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De broker gaf verlopen ICE-gegevens terug."
          }
        }
      }
    },
    "Could not set up the direct connection. Try again." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kon de directe verbinding niet opzetten. Probeer het opnieuw."
          }
        }
      }
    },
    "The connection sent invalid UTF-8." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De verbinding stuurde ongeldige UTF-8."
          }
        }
      }
    },
    "The data channel is not open." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het datakanaal is niet open."
          }
        }
      }
    },
    "The data channel refused a frame." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het datakanaal weigerde een frame."
          }
