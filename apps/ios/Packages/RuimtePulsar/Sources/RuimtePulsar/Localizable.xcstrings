{
  "sourceLanguage" : "en",
  "strings" : {
    "Apple did not finish the sign-in. Try again." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple rondde het inloggen niet af. Probeer het opnieuw."
          }
        }
      }
    },
    "Apple sign-in is not available right now. Try again later or sign in with GitHub." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inloggen met Apple is nu niet beschikbaar. Probeer het later opnieuw of log in met GitHub."
          }
        }
      }
    },
    "Apple's response does not belong to this sign-in. Try again." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het antwoord van Apple hoort niet bij deze inlogpoging. Probeer het opnieuw."
          }
        }
      }
    },
    "Could not turn on notifications." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kon meldingen niet aanzetten."
          }
        }
      }
    },
    "Could not sign in (%@)." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kon niet inloggen (%@)."
          }
        }
      }
    },
    "Sign-in canceled." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inloggen geannuleerd."
          }
        }
      }
    },
    "Your account answered with error %lld." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je account antwoordde met fout %lld."
          }
        }
      }
    },
    "Your account sent an answer this app cannot read." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je account stuurde een antwoord dat deze app niet kan lezen."
          }
        }
      }
    },
    "Could not reach your account." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kon je account niet bereiken."
          }
        }
      }
    },
    "The address book needs an HTTPS address." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het adresboek heeft een HTTPS-adres nodig."
          }
        }
      }
    },
    "Your account did not answer. Try again." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je account antwoordde niet. Probeer het opnieuw."
          }
        }
      }
    },
    "The answer from the browser does not belong to this sign-in. Try again." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
