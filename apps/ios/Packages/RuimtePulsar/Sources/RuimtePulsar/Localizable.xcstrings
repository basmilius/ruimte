{
  "sourceLanguage" : "en",
  "strings" : {
    "Apple returned an incomplete sign-in response. Please try again." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple gaf een onvolledig inlogantwoord terug. Probeer het opnieuw."
          }
        }
      }
    },
    "Apple sign-in is not available right now. Try again later or sign in with GitHub." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inloggen met Apple is nu niet beschikbaar. Probeer het later opnieuw of log in met GitHub."
          }
        }
      }
    },
    "Apple's response does not belong to this sign-in. Please try again." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het antwoord van Apple hoort niet bij deze inlogpoging. Probeer het opnieuw."
          }
        }
      }
    },
    "Converted to euros at the ECB rate of %@." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omgerekend naar euro's tegen de ECB-koers van %@."
          }
        }
      }
    },
    "Notifications could not be registered." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meldingen konden niet worden geregistreerd."
          }
        }
      }
    },
    "Paste an HTTPS pairing link ending in /pair#token." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plak een HTTPS pairing link die eindigt op /pair#token."
          }
        }
      }
    },
    "Showing US dollars until a euro exchange rate is available." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bedragen staan in Amerikaanse dollars tot er een wisselkoers voor de euro is."
          }
        }
      }
    },
