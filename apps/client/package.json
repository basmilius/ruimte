{
    "name": "@ruimte/client",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "build:bundle": "vite build",
        "build:station": "tsc -b && bun run bundle:station",
        "build:bench": "tsc -b && bun run bundle:bench",
        "bundle:station": "vite build --mode station --outDir ../station/dist --emptyOutDir",
        "bundle:bench": "vite build --mode bench --outDir ../bench/dist --emptyOutDir",
        "typecheck": "bun check --no-script -b",
        "preview": "vite preview"
    },
