{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "customConditions": ["source"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "lib": ["ES2023", "DOM"],
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "paths": { "@/*": ["./src/*"], "@extensions/*": ["../../extensions/*"] }
  },
  "include": ["src", "../../extensions/*/client"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/worker", "../../extensions/**/*.test.ts", "../../extensions/**/*.test.tsx"]
}
