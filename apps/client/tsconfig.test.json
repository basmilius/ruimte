{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "customConditions": ["bun", "source"],
        "resolveJsonModule": true,
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
        "lib": ["ES2023", "DOM"],
        "types": ["bun"],
        "jsx": "react-jsx",
        "paths": {
            "@/*": ["./src/*"],
            "@extensions/*": ["../../extensions/*"],
            "@ruimte/extension/*": ["../../packages/extension/*"]
        }
    },
    "include": [
        "src/**/*.test.ts",
        "src/**/*.test.tsx",
        "src/built-in-entry.d.ts",
        "../../extensions/**/*.test.ts",
        "../../extensions/**/*.test.tsx",
        "test-preload.ts",
        "testing/**/*.ts",
        "testing/**/*.tsx"
    ]
}
