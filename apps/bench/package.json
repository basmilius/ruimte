{
  "name": "@ruimte/bench",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "bun run --cwd ../client build:bench && mv dist/bench.html dist/index.html && cp -R public/. dist/",
    "deploy": "bun run build && wrangler deploy",
    "typecheck": "bun check --no-script && bun check --no-script -p tsconfig.test.json"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260922.1",
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2",
    "wrangler": "^4.136.3"
  },
  "dependencies": {
    "@ruimte/csp": "workspace:*"
  }
}
