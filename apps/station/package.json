{
  "name": "@ruimte/station",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "bun run --cwd ../client build:station && cp -R public/. dist/",
    "deploy": "bun run build && wrangler deploy",
    "typecheck": "bun check --no-script && bun check --no-script -p tsconfig.test.json"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261030.1",
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2",
    "wrangler": "^4.156.0"
  },
  "dependencies": {
    "@ruimte/csp": "workspace:*"
  }
}
