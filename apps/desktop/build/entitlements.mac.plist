<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- V8 in Electron and JavaScriptCore in the daemon JIT; without it the hardened runtime kills them. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- TCC attributes microphone requests from a terminal child to Ruimte's bundled daemon. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
