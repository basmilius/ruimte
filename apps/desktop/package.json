{
    "name": "@ruimte/desktop",
    "productName": "Ruimte",
    "private": true,
    "version": "0.0.0",
    "description": "Ruimte",
    "author": "Bas Milius",
    "homepage": "https://ruimte.app",
    "type": "module",
    "main": "dist/main.cjs",
    "desktopName": "ruimte.desktop",
    "scripts": {
        "build:main": "bun build --conditions=source src/main.ts --target=node --format=cjs --external electron --define \"process.env.RUIMTE_TELEMETRY=\\\"$RUIMTE_TELEMETRY\\\"\" --outfile dist/main.cjs && bun build --conditions=source src/preload.ts --target=node --format=cjs --external electron --outfile dist/preload.cjs && bun build --conditions=source src/guest.ts --target=node --format=cjs --external electron --outfile dist/guest.cjs",
        "dev": "bun run build:speech && bun run build:main && RUIMTE_DEV_URL=http://localhost:4212 bun scripts/launch.ts",
        "smoke": "bun run build:main && RUIMTE_DEV_URL=http://localhost:4212 RUIMTE_SMOKE=1 bun scripts/launch.ts",
        "build": "bun run build:main",
        "icon": "bun scripts/icon.ts",
        "typecheck": "bun check --no-script && bun check --no-script -p tsconfig.test.json",
        "start": "bun run build:main && bun scripts/launch.ts",
        "pack": "bun run build:main && electron-builder --publish never",
        "pack:dir": "bun run build:main && electron-builder --dir --publish never",
        "build:speech": "bun scripts/build-speech.ts",
        "build:foundation-models": "bun ../foundation-models/scripts/build.ts",
        "build:computer-use": "bun ../computer-use/scripts/build.ts"
    },
    "dependencies": {
        "@adecore/service": "0.49.1",
        "@adecore/shell": "0.49.1",
        "@ruimte/actions": "workspace:*",
        "@ruimte/contracts": "workspace:*",
        "@ruimte/csp": "workspace:*",
        "@ruimte/desktop-bridge": "workspace:*",
        "@ruimte/pulsar": "workspace:*",
        "@ruimte/service": "workspace:*",
        "@ruimte/telemetry": "workspace:*",
        "@ruimte/voice": "workspace:*",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@sentry/electron": "8.2.0",
        "@types/bun": "^1.4.2",
        "@types/node": "^24.13.6",
        "electron": "^45.0.0",
        "electron-builder": "^26.16.1",
        "electron-updater": "^6.8.11",
        "typescript": "^7.0.2"
    }
}
