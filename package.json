{
  "name": "ruimte",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run --filter './apps/*' dev",
    "dev:client": "bun run --cwd apps/client dev",
    "dev:server": "bun run --cwd apps/server dev",
    "build": "bun run --cwd apps/client build",
    "check": "bun run --filter '*' typecheck && oxlint",
    "lint": "oxlint",
    "test": "bun test"
  },
  "devDependencies": {
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2"
  }
}
