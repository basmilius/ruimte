{
  "name": "ruimte",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "adecore:link": "bun scripts/adecore.ts link",
    "adecore:npm": "bun scripts/adecore.ts npm",
    "adecore:status": "bun scripts/adecore.ts status",
    "dev": "bun scripts/adecore.ts status --brief && bun run --filter './apps/*' dev",
    "dev:client": "bun run --cwd apps/client dev",
    "dev:server": "bun run --cwd apps/server dev",
    "build": "bun run --cwd apps/client build && bun run --cwd apps/desktop build",
    "check": "tsc -p tsconfig.scripts.json && bun run --filter '*' typecheck && oxlint --deny-warnings",
    "lint": "oxlint --deny-warnings",
    "test": "bun test --conditions=source --parallel --only-failures",
    "test:integration": "bun scripts/test-integration.ts",
    "test:browser": "bun run --cwd apps/client build && bun scripts/test-integration.ts --browser",
    "test:terminal": "bun --config=integration.bunfig.toml test --conditions=source apps/server/src/sessions/terminal-stream.integration.test.ts",
    "format": "oxfmt --write \"apps/*/src/**/*.{ts,tsx}\" \"packages/*/src/**/*.ts\" \"scripts/**/*.ts\"",
    "format:check": "oxfmt --check \"apps/*/src/**/*.{ts,tsx}\" \"packages/*/src/**/*.ts\" \"scripts/**/*.ts\"",
    "dev:desktop": "bun run --cwd apps/desktop dev",
    "dist": "bun run --cwd apps/client build && bun run --cwd apps/server compile && bun run --cwd apps/desktop pack"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "typescript": "^7.0.2"
  },
  "trustedDependencies": [
    "electron"
  ],
  "patchedDependencies": {
    "werift@0.24.4": "patches/werift@0.24.4.patch"
  }
}
