{
  "name": "ruimte",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "extensions/*",
      "extensions/poc/*"
    ],
    "catalog": {
      "@adecore/agent-contracts": "0.64.0",
      "@adecore/agents": "0.64.0",
      "@adecore/agents-react": "0.64.0",
      "@adecore/charts": "0.64.0",
      "@adecore/database": "0.64.0",
      "@adecore/diagram": "0.64.0",
      "@adecore/drawing": "0.64.0",
      "@adecore/editor": "0.64.0",
      "@adecore/editor-react": "0.64.0",
      "@adecore/intelligent-ui": "0.64.0",
      "@adecore/lsp": "0.64.0",
      "@adecore/merge": "0.64.0",
      "@adecore/plan": "0.64.0",
      "@adecore/service": "0.64.0",
      "@adecore/shell": "0.64.0",
      "@adecore/terminal": "0.64.0",
      "@adecore/ui": "0.64.0",
      "@adecore/utils": "0.64.0"
    }
  },
  "scripts": {
    "adecore:link": "bun scripts/adecore.ts link",
    "adecore:npm": "bun scripts/adecore.ts npm",
    "adecore:status": "bun scripts/adecore.ts status",
    "adecore:bump": "bun scripts/adecore.ts bump",
    "adecore:check": "bun scripts/adecore.ts check",
    "dev": "bun scripts/adecore.ts status --brief && bun run --filter './apps/*' --filter '!./apps/site' dev",
    "dev:built": "bun scripts/adecore.ts status --brief && bun run --cwd apps/client build && bun run --parallel dev:client:built dev:server dev:desktop:built",
    "dev:client": "bun run --cwd apps/client dev",
    "dev:client:built": "bun run --cwd apps/client preview --port 4212 --strictPort",
    "dev:server": "bun run --cwd apps/server dev",
    "build": "bun run --cwd apps/client build && bun run --cwd apps/desktop build",
    "check": "bun run check:types && bun run check:generated && bun run lint && bun run format:check",
    "check:types": "bun check --no-script -p tsconfig.scripts.json && bun run --filter '*' typecheck",
    "check:generated": "bun run --cwd packages/contracts check:swift && bun packages/contracts/scripts/generate-extension-vocabularies.ts --check && bun apps/server/scripts/generate-extension-runtimes.ts --check",
    "generate:extension-runtimes": "bun apps/server/scripts/generate-extension-runtimes.ts",
    "lint": "oxlint --deny-warnings && oxlint --type-aware --deny-warnings -c apps/server/oxlint.promises.json apps/server/src && bun scripts/check-client-conventions.ts && bun scripts/check-test-clock.ts && bun scripts/check-built-ins.ts && bun scripts/check-module-cycles.ts && bun scripts/adecore.ts check",
    "symbolicate:electron": "bun scripts/symbolicate-electron.ts",
    "test": "bun test --conditions=source --parallel --no-isolate --only-failures --timings=test-timings.json",
    "test:windows": "bun test --conditions=source --parallel=8 --no-isolate --only-failures",
    "test:timings": "bun run test --update-timings",
    "test:dom": "bun --config=dom.bunfig.toml test --conditions=source .dom.test. && bun --config=dom.bunfig.toml test --isolate --conditions=source --path-ignore-patterns='**/*.integration.test.ts' .cold.test.",
    "test:integration": "bun scripts/test-integration.ts",
    "test:package": "bun scripts/test-integration.ts --suite package",
    "test:devices": "bun scripts/test-integration.ts --suite devices",
    "ui-check": "bun scripts/ui-check.ts",
    "test:terminal":"bun --config=integration.bunfig.toml test --conditions=source apps/server/src/sessions/terminal-stream.integration.test.ts",
    "format": "oxfmt --write \"apps/*/{src,testing,scripts,Scripts,build}/**/*.{ts,tsx,mjs,cjs}\" \"apps/*/*.{ts,tsx,mjs}\" \"extensions/**/*.{ts,tsx,js}\" \"packages/*/{src,scripts}/**/*.{ts,tsx}\" \"packages/extension/*.d.ts\" \"scripts/**/*.ts\"",
    "format:check": "oxfmt --check \"apps/*/{src,testing,scripts,Scripts,build}/**/*.{ts,tsx,mjs,cjs}\" \"apps/*/*.{ts,tsx,mjs}\" \"extensions/**/*.{ts,tsx,js}\" \"packages/*/{src,scripts}/**/*.{ts,tsx}\" \"packages/extension/*.d.ts\" \"scripts/**/*.ts\"",
    "dev:desktop": "bun run --cwd apps/desktop dev",
    "dev:desktop:built": "RUIMTE_DEV_WAIT_FOR_DAEMON=1 bun run dev:desktop",
    "dist": "bun run --cwd apps/client build && bun run --cwd apps/server compile && bun run --cwd apps/desktop pack"
  },
  "devDependencies": {
    "@adecore/diagram": "catalog:",
    "@adecore/drawing": "catalog:",
    "@adecore/ui": "catalog:",
    "@types/bun": "^1.4.4",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "^7.0.2",
    "oxc-parser": "^0.156.0"
  },
  "trustedDependencies": [
    "electron"
  ],
  "patchedDependencies": {
    "werift@0.25.2": "patches/werift@0.25.2.patch"
  }
}
